# ─── Mobile app (public values) ─────────────────────────────────────────────
# Clerk publishable key (pk_test_...) — safe to ship in the app bundle
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# PostHog project token + host (eu.i.posthog.com or us.i.posthog.com)
POSTHOG_PROJECT_TOKEN=phc_xxx
POSTHOG_HOST=https://eu.i.posthog.com

# ─── Server only (Expo API routes + Python agent) ───────────────────────────
# Clerk secret key (sk_test_...) — used by app/api/* to verify sessions
CLERK_SECRET_KEY=sk_test_xxx

# Stream (getstream.io) — the API key is public, the secret is NOT
STREAM_API_KEY=xxx
STREAM_API_SECRET=xxx

# URL of the Python teacher service, as seen from the Expo server
VISION_AGENT_URL=http://localhost:8000

# OpenAI key — only read by vision-agent/ (you can also put it in vision-agent/.env)
OPENAI_API_KEY=sk-xxx
