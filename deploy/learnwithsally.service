[Unit]
Description=LearnWithSally SaaS and voice teacher
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/learnwithsally/repository
LoadCredentialEncrypted=lws-secrets:/etc/credstore.encrypted/learnwithsally.cred
RuntimeDirectory=learnwithsally
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/install -m0600 %d/lws-secrets /run/learnwithsally/secrets.json
ExecStart=/usr/bin/docker compose -f deploy/compose.yml up --no-color --remove-orphans
ExecStop=/usr/bin/docker compose -f deploy/compose.yml down
Restart=on-failure
RestartSec=10
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
